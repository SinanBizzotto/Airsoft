# Optional. Ohne diese Datei läuft der Build ebenfalls — src/lib/supabase.js
# enthält die öffentlichen Projektwerte als Fallback.
#
# Sinnvoll ist eine eigene .env, wenn gegen ein anderes Supabase-Projekt
# entwickelt wird oder der Publishable Key gewechselt wurde. Gesetzte Werte
# haben Vorrang vor dem Fallback im Code.
#
# WICHTIG: Alles mit VITE_ Prefix landet im Client-Bundle und ist für jeden
# Besucher im Quelltext lesbar. Der Service-Role-Key und Webhook-URLs
# gehören hier NIE hinein.

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-publishable-key

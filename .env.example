# Kopie dieser Datei als `.env` anlegen und die Werte aus dem Supabase-Projekt eintragen.
# Achtung: Alles mit VITE_ Prefix landet im Client-Bundle und ist öffentlich sichtbar.
# Der Anon Key ist dafür gedacht — der Service-Role-Key gehört NIE hier hinein.

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
